# Skonfiguruj te zmienne, aby formularz kontaktowy realnie wysyłał e-maile.
# Bez nich formularz działa (odpowiada sukcesem), ale tylko loguje zgłoszenie
# w konsoli serwera — wygodne do demo, niewystarczające do produkcji.

# Skrzynka: ejbitap.biuro@wp.pl (poczta WP) — ustawienia SMTP potwierdzone
# w oficjalnej pomocy WP (pomoc.wp.pl), wrzesień 2026.
SMTP_HOST=smtp.wp.pl
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ejbitap.biuro@wp.pl
# Zwykłe hasło do skrzynki. Jeśli włączysz weryfikację dwuetapową na koncie WP,
# będziesz musiał wygenerować osobne "hasło aplikacji" i wpisać je tutaj zamiast
# zwykłego hasła.
SMTP_PASSWORD=twoje-haslo-do-skrzynki-wp

# Adres, na który mają trafiać zgłoszenia z formularza (domyślnie: siteConfig.contactEmail)
CONTACT_TO_EMAIL=ejbitap.biuro@wp.pl

# Adres nadawcy widoczny w wysyłanych powiadomieniach — musi być TĄ SAMĄ skrzynką
# co SMTP_USER. WP (jak większość dostawców pocztowych) odrzuca lub oznacza jako
# spam wiadomości, w których nadawca różni się od zalogowanej skrzynki.
CONTACT_FROM_EMAIL=ejbitap.biuro@wp.pl
